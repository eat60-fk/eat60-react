{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin/install",
      "destination": "/admin-install.html"
    },
    {
      "source": "/download-adminapp",
      "destination": "/admin-install.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
